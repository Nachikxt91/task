// SPDX-License-Identifier: MIT
pragma solidity ^0.8.21;


contract Prime {
    function isPrime(int n) public pure returns (string memory) {
        if (n <= 1) {
            return "Not Prime";
        }
        for (int i = 2; i * i <= n; i++) {
            if (n % i == 0) {
                return "Not Prime";
            }
        }
        return "Prime";
    }
}


