cat > phishing_url_lab.py <<'PY'
import os
import pandas as pd
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

from sklearn.model_selection import train_test_split
from sklearn.pipeline import Pipeline
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import (
    accuracy_score, precision_score, recall_score,
    f1_score, roc_auc_score, confusion_matrix,
    classification_report, ConfusionMatrixDisplay
)

os.makedirs("outputs", exist_ok=True)

df = pd.read_csv("datasets/urls_synthetic.csv")
df = df.dropna(subset=["url", "label"])
df["url"] = df["url"].astype(str)
df["label"] = df["label"].astype(int)

print("Dataset size:", len(df))
print("\nLabel counts:")
print(df["label"].value_counts().sort_index())

X_train, X_test, y_train, y_test = train_test_split(
    df["url"], df["label"],
    test_size=0.25, random_state=42, stratify=df["label"]
)

model = Pipeline([
    ("tfidf", TfidfVectorizer(analyzer="char", ngram_range=(3, 5))),
    ("lr", LogisticRegression(max_iter=1000))
])

model.fit(X_train, y_train)
pred = model.predict(X_test)
scores = model.predict_proba(X_test)[:, 1]

print(f"\nTraining records: {len(X_train)}")
print(f"Testing records: {len(X_test)}")
print(f"Accuracy:  {accuracy_score(y_test, pred):.3f}")
print(f"Precision: {precision_score(y_test, pred, zero_division=0):.3f}")
print(f"Recall:    {recall_score(y_test, pred, zero_division=0):.3f}")
print(f"F1-score:  {f1_score(y_test, pred, zero_division=0):.3f}")
print(f"ROC-AUC:   {roc_auc_score(y_test, scores):.3f}")

print("\nClassification report:")
print(classification_report(
    y_test, pred, target_names=["benign", "suspicious"], zero_division=0
))

cm = confusion_matrix(y_test, pred, labels=[0, 1])
print("Confusion matrix [[TN, FP], [FN, TP]]:")
print(cm)

ConfusionMatrixDisplay(
    confusion_matrix=cm,
    display_labels=["Benign", "Suspicious"]
).plot()
plt.tight_layout()
plt.savefig("outputs/url_confusion.png", dpi=150)
plt.close()

pd.DataFrame({
    "url": X_test.values,
    "true_label": y_test.values,
    "pred_label": pred,
    "suspicious_score": scores
}).to_csv("outputs/url_test_predictions.csv", index=False)

print("\nResults saved in the outputs/ folder.")
