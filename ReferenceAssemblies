contract Voting {
    mapping(string => uint) public ct;
    mapping(address => bool) public voters;


    string[] public cn;


    constructor(string[] memory cdn) {
        cn = cdn;
    }


    function vote(string memory c) public {
        require(!voters[msg.sender], "You have already voted");


        bool ce = false;


        for (uint i = 0; i < cn.length; i++) {
            if (keccak256(bytes(c)) == keccak256(bytes(cn[i]))) {
                ce = true;
                break;
            }
