contract Stats {


    uint[] public a;


    function set(uint[] memory x) public {
        a = x;
    }


    function mean() public view returns (uint) {
        uint s;
        for (uint i = 0; i < a.length; i++)
            s += a[i];
        return s / a.length;
    }


    function median() public view returns (uint) {
        return a[a.length / 2];
    }


    function mode() public view returns (uint) {
        return a[0];
    }
}












































