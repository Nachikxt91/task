import hashlib
import datetime
class Block:
    def __init__(self, i, amount, balance, ph):
        self.i = i
        self.t = str(datetime.datetime.now())
        self.amount = amount
        self.balance = balance
        self.ph = ph
        self.h = self.calhash()

    def calhash(self):
        data = str(self.i) + self.t + str(self.amount) + str(self.balance) + self.ph
        return hashlib.sha256(data.encode()).hexdigest()

class Blockchain:
    def __init__(self):
        self.balance = 0
        self.chain = [self.createGBlock()]


    def createGBlock(self):
        return Block(0, 0, 0, "0")


    def deposit(self, amount):
        self.balance += amount
        ph = self.chain[-1].h
        b = Block(len(self.chain), amount, self.balance, ph)
        self.chain.append(b)


    def withdraw(self, amount):
        if amount <= self.balance:
            self.balance -= amount
            ph = self.chain[-1].h
            b = Block(len(self.chain), -amount, self.balance, ph)
            self.chain.append(b)
        else:
            print("Insufficient Balance")


    def display(self):
        print("\nDeveloped by Abhishek Mudaliyar\n")


        for b in self.chain:
            print("Block No :", b.i)
            print("Timestamp :", b.t)
            print("Amount :", b.amount)
            print("Balance :", b.balance)
            print("Previous Hash :", b.ph)
            print("Current Hash :", b.h)
            print("-" * 50)

    def validate(self):
        for i in range(1, len(self.chain)):
            if self.chain[i].ph != self.chain[i-1].h:
                return False
        return True

