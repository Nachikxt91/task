// SPDX-License-Identifier: MIT
pragma solidity ^0.8.18;

contract SimpleBank {

    // Structure
    struct Account {
        uint accountNo;
        string name;
        uint balance;
        bool exists;
    }

    // Private mapping
    mapping(address => Account) private accounts;

    // Account number
    uint private nextAccountNo = 1001;


    // Create Account
    function createAccount(string memory _name) public {

        require(
            !accounts[msg.sender].exists,
            "Account already exists"
        );

        accounts[msg.sender] = Account(
            nextAccountNo,
            _name,
            0,
            true
        );

        nextAccountNo++;
    }


    // Deposit Ether
    function deposit() public payable {

        require(
            accounts[msg.sender].exists,
            "Create account first"
        );

        require(
            msg.value > 0,
            "Enter valid amount"
        );

        accounts[msg.sender].balance += msg.value;
    }


    // Withdraw Ether
    function withdraw(uint _amount) public {

        require(
            accounts[msg.sender].exists,
            "Account not found"
        );

        require(
            _amount > 0,
            "Enter valid amount"
        );

        require(
            accounts[msg.sender].balance >= _amount,
            "Insufficient balance"
        );

        // Reduce balance first
        accounts[msg.sender].balance -= _amount;

        // Send Ether
        (bool success, ) = payable(msg.sender).call{
            value: _amount
        }("");

        require(
            success,
            "Transfer failed"
        );
    }


    // Send Money to Another Account
    function sendMoney(
        address _receiver,
        uint _amount
    ) public {

        require(
            accounts[msg.sender].exists,
            "Sender account not found"
        );

        require(
            accounts[_receiver].exists,
            "Receiver account not found"
        );

        require(
            _amount > 0,
            "Enter valid amount"
        );

        require(
            accounts[msg.sender].balance >= _amount,
            "Insufficient balance"
        );

        // Deduct from sender
        accounts[msg.sender].balance -= _amount;

        // Add to receiver
        accounts[_receiver].balance += _amount;
    }


    // Check Balance
    function checkBalance()
        public
        view
        returns(uint)
    {
        require(
            accounts[msg.sender].exists,
            "Account not found"
        );

        return accounts[msg.sender].balance;
    }


    // Display Account
    function displayAccount()
        public
        view
        returns(
            uint,
            string memory,
            uint
        )
    {
        require(
            accounts[msg.sender].exists,
            "Account not found"
        );

        return (
            accounts[msg.sender].accountNo,
            accounts[msg.sender].name,
            accounts[msg.sender].balance
        );
    }


    // Check Account Exists
    function accountExists()
        public
        view
        returns(bool)
    {
        return accounts[msg.sender].exists;
    }


    // Close Account
    function closeAccount() public {

        require(
            accounts[msg.sender].exists,
            "Account not found"
        );

        require(
            accounts[msg.sender].balance == 0,
            "Withdraw balance first"
        );

        delete accounts[msg.sender];
    }
}











































