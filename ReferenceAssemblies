// SPDX-License-Identifier: MIT
pragma solidity ^0.8.20;

contract Vehicle {
    string public registrationNumber;
    string public brand;
    uint public rentalPricePerDay;

    constructor(
        string memory _registrationNumber,
        string memory _brand,
        uint _rentalPricePerDay
    ) {
        registrationNumber = _registrationNumber;
        brand = _brand;
        rentalPricePerDay = _rentalPricePerDay;
    }
}

contract CarRental is Vehicle {
    bool public available = true;
    address public renter;
    uint public returnDeadline;

    uint public penaltyPerDay = 0.01 ether;

    event VehicleRented(address renter, uint daysRented, uint amountPaid);
    event VehicleReturned(address renter, uint penalty);

    constructor(
        string memory _registrationNumber,
        string memory _brand,
        uint _rentalPricePerDay
    ) Vehicle(_registrationNumber, _brand, _rentalPricePerDay) {}

    function rentVehicle(uint daysRented) public payable {
        require(available, "Vehicle is not available");
        require(daysRented > 0, "Days must be greater than zero");
        require(
            msg.value >= rentalPricePerDay * daysRented,
            "Insufficient rental payment"
        );

        available = false;
        renter = msg.sender;
        returnDeadline = block.timestamp + (daysRented * 1 days);

        emit VehicleRented(
            msg.sender,
            daysRented,
            msg.value
        );
    }

    function returnVehicle() public {
        require(!available, "Vehicle is already available");
        require(msg.sender == renter, "Only renter can return vehicle");

        uint penalty = 0;

        if (block.timestamp > returnDeadline) {
            uint lateDays =
                (block.timestamp - returnDeadline) / 1 days;

            if ((block.timestamp - returnDeadline) % 1 days > 0) {
                lateDays++;
            }

            penalty = lateDays * penaltyPerDay;
        }

        available = true;
        renter = address(0);
        returnDeadline = 0;

        emit VehicleReturned(msg.sender, penalty);
    }

    function getPenalty() public view returns (uint) {
        if (available || block.timestamp <= returnDeadline) {
            return 0;
        }

        uint lateDays =
            (block.timestamp - returnDeadline) / 1 days;

        if ((block.timestamp - returnDeadline) % 1 days > 0) {
            lateDays++;
        }

        return lateDays * penaltyPerDay;
    }
}











































