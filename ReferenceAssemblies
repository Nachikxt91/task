class Block {
    constructor(i, t, num, ph = "") {
        this.i = i;
        this.t = t;
        this.ph = ph;
        this.num = num;
        this.result = this.isKaprekar(num);
        this.h = this.calHash();
    }


    isKaprekar(num) {
        if (num === 1) return true;


        let sq = (num * num).toString();


        for (let i = 1; i < sq.length; i++) {
            let left = parseInt(sq.substring(0, i)) || 0;
            let right = parseInt(sq.substring(i)) || 0;


            if (right > 0 && (left + right === num)) {
                return true;
            }
        }
        return false;
    }


    calHash() {
        return c.createHash("sha256")
            .update(this.i + this.t + this.num + this.result + this.ph)
            .digest("hex");
    }
}


