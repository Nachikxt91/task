// SPDX-License-Identifier: MIT
pragma solidity ^0.8.20;

contract Doctor {
    string public doctorName;
    string public specialization;
    uint public consultationFee;

    constructor(
        string memory _name,
        string memory _specialization,
        uint _fee
    ) {
        doctorName = _name;
        specialization = _specialization;
        consultationFee = _fee;
    }
}

contract Hospital is Doctor {
    address public owner;

    mapping(uint => address) public appointments;
    mapping(uint => uint) public payments;

    uint public constant CANCELLATION_FEE = 0.001 ether;

    event AppointmentBooked(
        address indexed patient,
        uint indexed slot,
        uint fee
    );

    event AppointmentCancelled(
        address indexed patient,
        uint indexed slot,
        uint refund
    );

    constructor(
        string memory _name,
        string memory _specialization,
        uint _fee
    ) Doctor(_name, _specialization, _fee) {
        owner = msg.sender;
    }

    modifier onlyOwner() {
        require(msg.sender == owner, "Only owner can update fee");
        _;
    }

    function bookAppointment(uint slot) public payable {
        require(slot > 0, "Invalid appointment slot");
        require(appointments[slot] == address(0), "Slot already booked");
        require(msg.value >= consultationFee, "Insufficient consultation fee");

        appointments[slot] = msg.sender;
        payments[slot] = msg.value;

        emit AppointmentBooked(msg.sender, slot, msg.value);
    }

    function cancelAppointment(uint slot) public {
        require(appointments[slot] == msg.sender, "Not your appointment");

        uint paid = payments[slot];
        uint fee = paid < CANCELLATION_FEE
            ? paid
            : CANCELLATION_FEE;
        uint refund = paid - fee;

        appointments[slot] = address(0);
        payments[slot] = 0;

        (bool success, ) = payable(msg.sender).call{value: refund}("");
        require(success, "Refund failed");

        emit AppointmentCancelled(msg.sender, slot, refund);
    }

    function updateConsultationFee(uint newFee) public onlyOwner {
        consultationFee = newFee;
    }

    function isSlotAvailable(uint slot) public view returns (bool) {
        return appointments[slot] == address(0);
    }
}











































