contract StudentData {

    struct Student {
        string name;
        string studentAddress;
        uint rollNo;
        uint[5] marks;
    }

    Student[] students;

    // Add Student (Maximum 5)
    function addStudent(
        string memory _name,
        string memory _address,
        uint _roll,
        uint[5] memory _marks
    ) public {

        require(students.length < 5, "Only 5 students allowed");

        students.push(Student(_name, _address, _roll, _marks));
    }

    // Display Student by Roll Number
    function getStudent(uint _roll)
        public
        view
        returns (
            string memory,
            string memory,
            uint,
            uint,
            string memory,
            string memory
        )
    {
        for(uint i = 0; i < students.length; i++) {

            if(students[i].rollNo == _roll) {

                uint total = 0;

                for(uint j = 0; j < 5; j++)
                    total += students[i].marks[j];

                uint percentage = total / 5;

                string memory grade;
                string memory remark;

                if(percentage >= 90){
                    grade = "O";
                    remark = "Outstanding";
                }
                else if(percentage >= 75){
                    grade = "A";
                    remark = "Scored Well";
                }
                else if(percentage >= 60){
                    grade = "B";
                    remark = "Good";
                }
                else{
                    grade = "C";
                    remark = "Need More Hard Work";
                }

                return (
                    students[i].name,
                    students[i].studentAddress,
                    percentage,
                    students[i].rollNo,
                    grade,
                    remark
                );
            }
        }

        revert("Student Not Found");
    }
}











































