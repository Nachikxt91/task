const c = require("crypto");
class Block{
    constructor(i,t,n,ph=""){
        this.i = i;
        this.t = t;
        this.ph = ph;
        this.n = n;
        this.prime = this.checkPrime(n);
        this.h = this.calHash();
    }
    calHash(){
        return c.createHash("sha256").update(this.i + this.t + this.prime + this.ph).digest('hex');
    }
    checkPrime(n) {
        n = this.n;
        if(n<=1)
            return false;
        for(let i = 2; i <= Math.sqrt(n); i++)
            if(n%i===0)
                return false;
        return true;
    }
}

