contract Palindrome {


    function checkPalindrome(uint n) public pure returns (bool) {
        uint rev = 0;
        uint temp = n;


        while (temp > 0) {
            rev = rev * 10 + temp % 10;
            temp = temp / 10;
        }


        return rev == n;
    }
